---
import { site } from "../data/site";

const links = [
    { href: "/#research", label: "Research", hide: "" },
    { href: "/#publications", label: "Publications", hide: "hidden md:block" },
    { href: "/#projects", label: "Projects", hide: "" },
    { href: "/#experience", label: "Experience", hide: "hidden lg:block" },
    { href: "/#education", label: "Education", hide: "hidden lg:block" },
    { href: "/#contact", label: "Contact", hide: "hidden xl:block" },
    { href: "/cv", label: "CV", hide: "" },
];
---

<nav id="siteNav" class="site-nav sticky top-0 z-40">
    <div
        class="relative mx-auto flex max-w-5xl items-center justify-end px-5 pr-24 py-2.5 sm:px-8 sm:py-4 sm:pr-24 lg:pr-20"
    >
        <a
            href="/"
            id="navName"
            class="site-nav__name absolute left-5 font-serif text-2xl font-semibold tracking-tight sm:left-8 sm:text-3xl"
        >
            <span class="text-accent">{site.firstName}</span>{" "}<span
                >{site.restName}</span
            >
        </a>

        <ul
            class="hidden items-center gap-3.5 text-[15.5px] text-muted sm:flex sm:gap-6 sm:text-[16px]"
        >
            {
                links.map((l) => (
                    <li class={l.hide}>
                        <a
                            href={l.href}
                            class="transition-colors hover:text-accent"
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <button
            id="navToggle"
            type="button"
            class="nav-burger"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="navMenu"
        >
            <span></span><span></span><span></span>
        </button>
    </div>

    <div id="navMenu" class="nav-menu" hidden>
        <ul class="mx-auto max-w-5xl px-5 pb-5">
            {
                links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            class="block border-b border-line py-3.5 text-[17px] text-ink transition-colors hover:text-accent"
                        >
                            {l.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>

<style>
    .site-nav {
        background: transparent;
        border-bottom: 1px solid transparent;
        transition:
            background-color 450ms ease,
            border-color 450ms ease,
            box-shadow 450ms ease,
            backdrop-filter 450ms ease,
            -webkit-backdrop-filter 450ms ease;
    }

    .site-nav.is-scrolled,
    .site-nav.menu-open {
        background: color-mix(in srgb, var(--bg) 62%, transparent);
        border-bottom-color: color-mix(in srgb, var(--accent) 22%, transparent);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        box-shadow: 0 8px 32px -20px rgb(0 0 0 / 0.55);
    }
    .site-nav.menu-open {
        background: color-mix(in srgb, var(--bg) 92%, transparent);
    }

    @supports not (backdrop-filter: blur(1px)) {
        .site-nav.is-scrolled,
        .site-nav.menu-open {
            background: color-mix(in srgb, var(--bg) 96%, transparent);
        }
    }

    .site-nav__name {
        top: 50%;
        opacity: 0;
        transform: translateY(calc(-50% - 14px));
        pointer-events: none;
        white-space: nowrap;
        transition:
            opacity 620ms cubic-bezier(0.22, 1, 0.36, 1),
            transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .site-nav.show-name .site-nav__name,
    .site-nav.menu-open .site-nav__name {
        opacity: 1;
        transform: translateY(-50%);
        pointer-events: auto;
    }

    .nav-burger {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        padding: 0 10px;
        border: 0;
        background: transparent;
        cursor: pointer;
    }
    .nav-burger span {
        display: block;
        height: 2px;
        width: 100%;
        border-radius: 2px;
        background: var(--ink);
        transition:
            transform 280ms cubic-bezier(0.4, 0, 0.2, 1),
            opacity 180ms ease;
    }
    .site-nav.menu-open .nav-burger span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    .site-nav.menu-open .nav-burger span:nth-child(2) {
        opacity: 0;
    }
    .site-nav.menu-open .nav-burger span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }

    .nav-menu {
        display: none;
        overflow: hidden;
    }
    .nav-menu li:last-child a {
        border-bottom: 0;
    }

    @media (max-width: 639.98px) {
        .nav-burger {
            display: flex;
        }
        .nav-menu:not([hidden]) {
            display: block;
            animation: menu-in 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
        }
    }

    @keyframes menu-in {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .site-nav,
        .site-nav__name,
        .nav-burger span,
        .nav-menu {
            transition: none;
            animation: none;
        }
    }
</style>

<script>
    const nav = document.getElementById("siteNav")!;
    const name = document.getElementById("navName") as HTMLAnchorElement | null;
    const intro = document.getElementById("intro");
    const toggle = document.getElementById("navToggle")!;
    const menu = document.getElementById("navMenu")!;

    let ticking = false;
    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            nav.classList.toggle("is-scrolled", window.scrollY > 8);
            ticking = false;
        });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    function setMenu(open: boolean) {
        nav.classList.toggle("menu-open", open);
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }

    toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        setMenu(menu.hidden);
    });

    menu.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) setMenu(false);
    });

    document.addEventListener("click", (e) => {
        if (menu.hidden) return;
        if (!nav.contains(e.target as Node)) setMenu(false);
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !menu.hidden) {
            setMenu(false);
            toggle.focus();
        }
    });

    const mq = window.matchMedia("(min-width: 640px)");
    mq.addEventListener("change", (e) => {
        if (e.matches) setMenu(false);
    });

    if (!intro) {
        nav.classList.add("show-name");
    } else {
        const io = new IntersectionObserver(
            ([entry]) =>
                nav.classList.toggle("show-name", !entry.isIntersecting),
            { rootMargin: "-72px 0px 0px 0px", threshold: 0 },
        );
        io.observe(intro);

        name?.addEventListener("click", (e) => {
            e.preventDefault();
            const reduce = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
            history.replaceState(null, "", "/");
        });
    }
</script>
