---
---

<div id="lamp" class="lamp">
    <div class="lamp__fixture" id="lampFixture">
        <svg
            width="120"
            height="340"
            viewBox="0 0 120 340"
            fill="none"
            aria-hidden="true"
        >
            <path
                id="lampCord"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"></path>

            <g id="lampBulbGroup">
                <circle class="lamp__halo" r="26" cx="0" cy="30"></circle>
                <rect
                    class="lamp__cap"
                    x="-3.6"
                    y="-0.5"
                    width="7.2"
                    height="5"
                    rx="1.4"></rect>

                <g class="lamp__sun">
                    <circle cx="0" cy="30" r="12"></circle>
                    <g
                        class="lamp__rays"
                        stroke-linecap="round"
                        stroke-width="3.4"
                    >
                        <line x1="0" y1="7" x2="0" y2="13"></line>
                        <line x1="0" y1="53" x2="0" y2="47"></line>
                        <line x1="-23" y1="30" x2="-17" y2="30"></line>
                        <line x1="23" y1="30" x2="17" y2="30"></line>
                        <line x1="-16.3" y1="13.7" x2="-12" y2="18"></line>
                        <line x1="16.3" y1="13.7" x2="12" y2="18"></line>
                        <line x1="-16.3" y1="46.3" x2="-12" y2="42"></line>
                        <line x1="16.3" y1="46.3" x2="12" y2="42"></line>
                    </g>
                </g>

                <g class="lamp__moon">
                    <path
                        transform="translate(0 30) scale(2) translate(-12 -12)"
                        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    ></path>
                </g>
            </g>
        </svg>

        <button id="lampKnob" class="lamp__knob" type="button">
            <span class="lamp__sr" id="lampKnobLabel">Switch to dark mode</span>
        </button>
    </div>

    <span class="lamp__tip" id="lampTip" aria-hidden="true">Dark mode</span>
</div>

<style>
    .lamp {
        position: fixed;
        inset: 0;
        z-index: 100;
        pointer-events: none;
        color: #4a5a6b;
    }

    .lamp__fixture {
        position: absolute;
        top: 0;
        left: 50%;
        width: 120px;
        transform-origin: 50% 0;
        transform: translateX(-50%) translateX(var(--dock-x, 0px))
            translateY(-23px) scale(0.46);
        pointer-events: auto;
    }

    .lamp__cap {
        fill: var(--muted);
    }
    .lamp__sun {
        fill: var(--accent);
        stroke: var(--accent);
    }
    .lamp__rays {
        stroke: var(--accent);
    }
    .lamp__moon {
        fill: var(--accent);
    }
    .lamp__sun {
        display: none;
    }
    :root[data-theme="dark"] .lamp__sun {
        display: block;
    }
    :root[data-theme="dark"] .lamp__moon {
        display: none;
    }

    .lamp__halo {
        fill: rgba(110, 220, 255, 0.55);
        opacity: 0;
        filter: blur(8px);
    }
    :root[data-theme="dark"] .lamp__halo {
        opacity: 0.4;
    }

    .lamp__knob {
        position: absolute;
        left: 50%;
        top: 0;
        width: 108px;
        height: 108px;
        margin-left: -54px;
        margin-top: -54px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
    }
    .lamp__knob:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }

    .lamp__sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .lamp__tip {
        position: absolute;
        top: 62px;
        right: 12px;
        padding: 4px 9px;
        border: 1px solid var(--line);
        border-radius: 5px;
        background: var(--surface);
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.06em;
        white-space: nowrap;
        opacity: 0;
        transform: translateY(-4px);
        pointer-events: none;
        transition:
            opacity 200ms ease,
            transform 200ms ease;
    }
    .lamp.is-hover .lamp__tip {
        opacity: 1;
        transform: none;
    }

    @media (max-width: 640px) {
        .lamp__fixture {
            transform: translateX(-50%) translateX(var(--dock-x, 0px))
                translateY(-12px) scale(0.4);
        }
    }
</style>

<script>
    const stage = document.getElementById("lamp")!;
    const cord = document.getElementById("lampCord")!;
    const bulbGroup = document.getElementById("lampBulbGroup")!;
    const knob = document.getElementById("lampKnob")!;
    const knobLabel = document.getElementById("lampKnobLabel")!;
    const tip = document.getElementById("lampTip")!;
    const root = document.documentElement;

    const CX = 60;
    const REST = 82;
    const K = 180;
    const C = 14;

    let pull = 0;
    let vel = 0;
    let raf: number | null = null;
    let last = 0;

    function measure() {
        const w = root.clientWidth || window.innerWidth || 0;
        if (w > 0) {
            root.style.setProperty("--dock-x", `${w / 2 - (w < 640 ? 34 : 46)}px`);
        }
        draw();
    }

    function draw() {
        const y = REST + pull;
        const sway = Math.max(-16, Math.min(16, vel * 0.05));
        const endX = CX + sway * 0.35;
        cord.setAttribute("d", `M ${CX} -10 Q ${CX + sway} ${y * 0.55} ${endX} ${y}`);
        bulbGroup.setAttribute("transform", `translate(${endX} ${y})`);
        knob.style.transform = `translateY(${y + 30}px)`;
    }

    function tick(t: number) {
        if (!last) last = t;
        const dt = Math.min((t - last) / 1000, 1 / 30);
        last = t;
        const accel = -K * pull - C * vel;
        vel += accel * dt;
        pull += vel * dt;
        draw();
        if (Math.abs(pull) < 0.3 && Math.abs(vel) < 2) {
            pull = 0;
            vel = 0;
            draw();
            raf = null;
            last = 0;
            return;
        }
        raf = requestAnimationFrame(tick);
    }

    function labelFor(theme: string) {
        return theme === "dark" ? "Light mode" : "Dark mode";
    }

    function apply(theme: string) {
        tip.textContent = labelFor(theme);
        knobLabel.textContent =
            theme === "dark" ? "Switch to light mode" : "Switch to dark mode";
    }

    function toggle() {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
            localStorage.setItem("theme", next);
        } catch (e) {}
        apply(next);
        vel = 700;
        if (raf === null) raf = requestAnimationFrame(tick);
    }

    knob.addEventListener("click", toggle);
    for (const ev of ["pointerenter", "focus"]) {
        knob.addEventListener(ev, () => stage.classList.add("is-hover"));
    }
    for (const ev of ["pointerleave", "blur"]) {
        knob.addEventListener(ev, () => stage.classList.remove("is-hover"));
    }
    window.addEventListener("resize", measure);

    measure();
    apply(root.dataset.theme === "dark" ? "dark" : "light");
</script>
